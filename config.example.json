{
  "api": {
    "key": "your-api-key-here",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-v4-flash",
    "timeout": 2000,
    "generation_params": {
      "temperature": 1.3,
      "top_p": 0.9,
      "max_tokens": 131072,
      "reasoning_effort": "medium"
    }
  },
  "transcription": {
    "infer_exe": "./转录模型/infer.exe",
    "model_dir": "./转录模型/models",
    "device": "cuda",
    "compute_type": "int8_float16",
    "audio_suffixes": "mp3,wav,flac,m4a,aac,ogg,wma,mp4,mkv,avi,mov,webm,flv,wmv",
    "sub_formats": "lrc"
  },
  "app": {
    "lrc_max_lines_per_request": 100,
    "translation_mode": "per_track",
    "scriptbook_mode": "full",
    "export_ja_lrc": true,
    "use_scriptbook_for_translation": true,
    "export_scriptbook_content": true,
    "retry_count": 4,
    "delay_between_requests": 0.2,
    "work_dir": "",
    "input_path_file": "input_path.txt",
    "debug": false,
    "audio_suffixes": [
      ".mp3",
      ".wav",
      ".flac",
      ".m4a",
      ".aac",
      ".ogg",
      ".wma",
      ".mp4",
      ".mkv",
      ".avi",
      ".mov",
      ".webm",
      ".flv",
      ".wmv"
    ],
    "subtitle_exts": [
      ".lrc",
      ".srt",
      ".vtt"
    ]
  },
  "pricing": {
    "hit_per_1m": 0.02,
    "miss_per_1m": 1,
    "completion_per_1m": 2
  },
  "ocr": {
    "dpi": 300,
    "x_tolerance": 30,
    "vertical_ratio_threshold": 1.2,
    "vertical_block_ratio": 0.3,
    "adaptive_threshold_block_size": 31,
    "adaptive_threshold_c": 10,
    "text_det_thresh": 0.3,
    "text_det_box_thresh": 0.5,
    "text_recognition_batch_size": 6,
    "use_gpu": true
  },
  "prompts": {
    "system_prompt_file": ""
  },
  "network": {
    "clear_proxy_on_startup": true
  },
  "active_preset": "default"
}